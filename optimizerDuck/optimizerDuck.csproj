<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <!-- CET shadow stacks are enabled by default for .NET 9+ apphosts/singlefilehosts,
             but the CoreCLR requires QueueUserAPC2 (Windows 11 build 22000+ / Server 2022
             only - it does not exist on Windows 10) whenever shadow stacks are active, so
             every published build fails to start on Windows 10 with 0x80131506 ("Your
             Windows doesn't fully support CET"). Disable CETCompat to keep the Windows 10
             support the README promises. See #50. -->
        <CETCompat>false</CETCompat>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <!-- Dadeum is a fork of optimizerDuck. The exe is renamed, but the root namespace stays
             "optimizerDuck" so embedded resources keep their names and upstream merges stay easy. -->
        <AssemblyName>Dadeum</AssemblyName>
        <RootNamespace>optimizerDuck</RootNamespace>
        <Authors>Dadeum contributors; fatDuck (optimizerDuck)</Authors>
        <ApplicationIcon>Logo.ico</ApplicationIcon>
        <Company>Dadeum</Company>
        <FileVersion>0.1.0</FileVersion>
        <Version>0.1.0</Version>
        <Product>Dadeum</Product>
        <Copyright>Copyright (C) 2026 Dadeum contributors. Based on optimizerDuck, Copyright (C) 2025-2026 fatDuck. GPL-3.0</Copyright>
        <AssemblyTitle>Dadeum</AssemblyTitle>
        <AssemblyDescription>Free, open-source Windows optimization tool (fork of optimizerDuck).</AssemblyDescription>
        <NeutralLanguage>en-US</NeutralLanguage>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- The gate: a warning fails the build, and the promoted style rules run inside it. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup>
        <Page Update="UI\Windows\MainWindow.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="UI\Pages\Optimize\Categories\OptimizationPage.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="UI\Pages\Features\FeaturesPage.xaml">
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Serilog" Version="4.4.1-dependabot-02442" />
        <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="8.0.0-nblumhardt-02322" />
        <PackageReference Include="System.Management.Automation" Version="7.6.99-rebuild.99" />
        <PackageReference Include="TaskScheduler" Version="2.12.2" />
        <PackageReference Include="WPF-UI" Version="4.3.0" />
        <PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="optimizerDuck.Test" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\Languages\Translations.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Translations.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\Embedded\Icons\blank.ico" />
        <EmbeddedResource Include="Resources\Embedded\PowerPlans\optimizerDuck.pow" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Resources\Images\Duck.png" />
        <Resource Include="Resources\Images\GitHubLogoBlack.png" />
        <Resource Include="Resources\Images\GitHubLogoWhite.png" />
        <Resource Include="Resources\Images\DiscordLogo.png" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Resources\Languages\Translations.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Translations.resx</DependentUpon>
        </Compile>
    </ItemGroup>
</Project>
